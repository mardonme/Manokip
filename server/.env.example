# PostgreSQL connection string.
# Local example: postgresql://postgres:postgres@localhost:5432/manokip
# Production (VPS): the Postgres service from /opt/manokip/docker-compose.yml.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

PORT=4000

# REQUIRED in production. Long random string, >= 32 chars. Generate one:
#   openssl rand -hex 64
# The server REFUSES to boot in production if this is unset, too short, or a
# known placeholder. Never reuse the dev value in production.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# REQUIRED in production. Comma-separated list of allowed frontend origins
# (no trailing slash). In production every entry must be https and not "*".
#   CORS_ORIGIN="https://manokip.com.uz,https://www.manokip.com.uz"
CORS_ORIGIN="http://localhost:5173"

# Seed admin user. CHANGE ADMIN_PASSWORD before seeding production.
ADMIN_EMAIL="admin@manokip.local"
ADMIN_PASSWORD="admin1234"

# "production" on the VPS, "development" locally.
NODE_ENV="development"

# --- Telegram admin notifications (so'rovnoma / zakaz) ---
# Bot token from @BotFather. When unset, notifications are silently skipped.
# SECURITY: treat as a secret — rotate via @BotFather if it ever leaks.
BOT_TOKEN=""
# The admin chat id to notify. To find it: start the server, open your bot in
# Telegram and send /start — the bot replies with your chat id. Paste it here.
ADMIN_CHAT_ID=""
# Set to "false" to disable the /start chat-id helper poller (e.g. if you run
# multiple server instances or use a webhook instead).
TELEGRAM_POLLING="true"

# --- AI assistant (Gemini) ---
# Get a free key at https://aistudio.google.com (no credit card required).
# When unset, /api/chat replies with an operator-handoff fallback.
# SECURITY: treat as a secret — rotate in Google AI Studio if it ever leaks.
GEMINI_API_KEY=""
# Model id. gemini-2.5-flash works on the current free tier. Alternatives:
# gemini-2.5-flash-lite (cheaper/faster), gemini-2.5-pro (smarter, pricier).
GEMINI_MODEL="gemini-2.5-flash"
# Per-request timeout (ms) and soft daily ceiling for outbound Gemini calls.
AI_TIMEOUT_MS=10000
AI_DAILY_CAP=2000
